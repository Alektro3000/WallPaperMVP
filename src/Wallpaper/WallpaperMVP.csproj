<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TransparentMode>false</TransparentMode>
    <Optimize>false</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TransparentMode)' == 'true'">
    <DefineConstants>$(DefineConstants);TRANSPARENT</DefineConstants>
  </PropertyGroup>
  
  
  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
     <DefineConstants>DEBUGDXOFF</DefineConstants> 
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishSingleFile>true</PublishSingleFile>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="SharpGLTF.Core" Version="1.0.6" />
    <PackageReference Include="Vortice.Direct3D12" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup Condition="'$(TransparentMode)' == 'true'">
    <PackageReference Include="Vortice.DirectComposition" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
  </ItemGroup>
  <ItemGroup>
    <ShaderCompilerInputs Include="$(MSBuildProjectDirectory)\Shaders\**\*.hlsl" />
    <ShaderCompilerInputs Include="$(MSBuildProjectDirectory)\Shaders\**\*.hlsli" />
    <ShaderCompilerInputs Include="$(MSBuildProjectDirectory)\..\..\Tools\ShaderCompiler\Program.cs" />
    <ShaderCompilerInputs Include="$(MSBuildProjectDirectory)\..\..\Tools\ShaderCompiler\ShaderCompiler.csproj" />
  </ItemGroup>

  <Target Name="CompileShaders"
          AfterTargets="Build"
          Inputs="@(ShaderCompilerInputs)"
          Outputs="$([System.IO.Path]::GetDirectoryName($(TargetPath)))\shaders\.shadercompile.stamp">
    <Exec Command="dotnet run --no-restore --project &quot;$(MSBuildProjectDirectory)\..\..\tools\ShaderCompiler\ShaderCompiler.csproj&quot; -- &quot;$(MSBuildProjectDirectory)&quot; &quot;$([System.IO.Path]::GetDirectoryName($(TargetPath)))&quot;" />
    <Touch Files="$([System.IO.Path]::GetDirectoryName($(TargetPath)))\shaders\.shadercompile.stamp" AlwaysCreate="true" />
  </Target>
  <ItemGroup>
    <None Include="..\..\resources\**\*.*" Link="resources\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
